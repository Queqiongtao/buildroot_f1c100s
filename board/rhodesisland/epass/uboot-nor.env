kernaddr=0x80008000
dtbaddr=0x80C00000
dtboaddr=0x80D00000
fitaddr=0x81000000
fbaddr=0x81800000

device_rev=0.6
screen=hsd
interface=
ext=nor
extracmd=

dtbs_offset=0x80000
dtbs_size=0x80000
kernel_offset=0x100000
kernel_size=0x3c0000

enterdfu_nor=setenv dfu_alt_info "all raw 0x0 0x1000000;u-boot raw 0x0 0x80000;dtbs raw 0x80000 0x80000;kernel raw 0x100000 0x3c0000;rootfs raw 0x4c0000 0xac0000;data raw 0xf80000 0x80000"; \
    dfu 0 sf 0:0

probenor=sf probe 0:0 50000000 0
loaddtbs_nor=run probenor; \
    sf read ${fitaddr} ${dtbs_offset} ${dtbs_size}; \
    if fdt addr ${fitaddr}; then \
        imxtract ${fitaddr} fdt-base-${device_rev} ${dtbaddr}; \
        imxtract ${fitaddr} fdt-screen-${screen} ${dtboaddr}; \
    else \
        echo "NOR DTBs FIT invalid, entering DFU"; \
        run enterdfu_nor; \
    fi

loadkernel_nor=run probenor; \
    sf read ${fitaddr} ${kernel_offset} ${kernel_size}; \
    if fdt addr ${fitaddr}; then \
        imxtract ${fitaddr} kernel ${kernaddr}; \
    else \
        echo "NOR kernel FIT invalid, entering DFU"; \
        run enterdfu_nor; \
    fi

patchbasic=fdt addr ${dtbaddr}; fdt resize 32768; fdt apply ${dtboaddr};
patchinterface=for ov in ${interface}; do \
    echo Applying Interface ${ov}...; \
    imxtract ${fitaddr} fdt-iface-${ov} ${dtboaddr}; \
    fdt apply ${dtboaddr}; \
done
patchext=for ov in ${ext}; do \
    echo Applying Extension ${ov}...; \
    imxtract ${fitaddr} fdt-ext-${ov} ${dtboaddr}; \
    fdt apply ${dtboaddr}; \
done
panelinit=srgn_st7701init ${dtbaddr}
splash=if imxtract ${fitaddr} logo-${screen} ${fbaddr}; then \
    srgn_splash ${dtbaddr} ${fbaddr}; \
fi
splashargs=if test -n "${splash_active}"; then \
    setenv bootargs "${bootargs} clk_ignore_unused"; \
fi

ensurecmdline_nor=if test -z "$bootargs"; then \
    setenv bootargs "console=ttyS0,115200 panic=0 rootwait root=/dev/mtdblock3 ro rootfstype=squashfs overlayfsdev=/dev/mtdblock4 init=/preinit"; \
fi

quietargs=if chk_verbose_boot ${dtbaddr}; then \
    true; \
else \
    echo ===========================; \
    echo srgn:default to quiet boot.; \
    echo HOLD KEY_1 for Verbose boot!; \
    echo ===========================; \
    setenv bootargs "${bootargs} quiet"; \
fi

extraargs=if test -n "${extracmd}"; then \
    setenv bootargs "${bootargs} ${extracmd}"; \
fi

distro_bootcmd=run loaddtbs_nor; \
    run patchbasic; run patchinterface; run patchext; \
    init_verbose_key ${dtbaddr}; \
    run panelinit; run splash; \
    run loadkernel_nor; run ensurecmdline_nor; \
    run quietargs; run splashargs; run extraargs; \
    bootz ${kernaddr} - ${dtbaddr}; \
    run enterdfu_nor

bootcmd=run distro_bootcmd
